// Config explicita do Worker — sem ela o wrangler auto-detecta "Next.js" e
// tenta migrar pra OpenNext (SSR), que nao se aplica a este projeto (export
// estatico). Modelo: so Static Assets, sem codigo de Worker. O Cloudflare serve
// out/ direto; um path que nao bate com nenhum arquivo recebe o out/404.html
// gerado pelo Next (src/app/not-found.tsx).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-website",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  // Exigido pelo `wrangler preview` que o Workers Builds roda nas branches de
  // PR. Vazio: o Preview usa so as configs de topo (assets).
  "previews": {}
}
