// Config explicita do Worker — sem ela o wrangler auto-detecta "Next.js" e
// tenta migrar pra OpenNext (SSR), que nao se aplica a este projeto (export
// estatico). Modelo: Static Assets — serve out/ e usa o Worker main so para
// /api/github/contributions. O Cloudflare serve os assets direto sem passar
// pelo Worker; o Worker roda apenas para paths que nao batem com nenhum asset.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-website",
  "main": "worker.ts",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  }
}